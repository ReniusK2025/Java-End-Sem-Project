    {
      "name": "4. Vaccinations",
      "item": [
        {
          "name": "Record Vaccination",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pets/{{petId}}/vaccinations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pets",
                "{{petId}}",
                "vaccinations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vaccinationDate\": \"{{vaccinationDate}}\",\n  \"vaccineTypeId\": \"{{vaccineTypeId}}\",\n  \"notes\": \"Postman normal path\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const d=new Date(); d.setDate(d.getDate()-360); pm.collectionVariables.set(\"vaccinationDate\",d.toISOString().slice(0,10));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Created\",()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json(); pm.collectionVariables.set(\"vaccinationId\",j.vaccinationId);",
                  "pm.test(\"nextDueDate is calculated\",()=>pm.expect(j.nextDueDate).to.exist);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Vaccination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vaccinations/{{vaccinationId}}",
